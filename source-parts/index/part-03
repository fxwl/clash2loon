  });
  ctx.waitUntil(cachePut(request, response.clone(), ttl, `inline:${index}`));
  return response;
}

export default {
  async fetch(request, env, ctx) {
    try {
      const url = new URL(request.url);
      if (url.pathname === '/health') {
        return json({ ok: true, service: 'clash2loon', time: new Date().toISOString() });
      }

      if (!authorized(request, env)) {
        return json({ ok: false, error: 'Unauthorized' }, 401, {
          'www-authenticate': 'Bearer realm="clash2loon"'
        });
      }

      if (url.pathname === '/' || url.pathname === '/loon') return handleLoon(request, env, ctx);
      if (url.pathname === '/nodes') return handleNodes(request, env, ctx);
      if (url.pathname === '/status') return handleStatus(request, env, ctx);

      const ruleMatch = url.pathname.match(/^\/rule\/(.+)$/);
      if (ruleMatch) return handleRule(request, env, ctx, decodeURIComponent(ruleMatch[1]));

      const inlineMatch = url.pathname.match(/^\/inline\/(\d+)$/);
      if (inlineMatch) return handleInline(request, env, ctx, inlineMatch[1]);

      return json({
        ok: false,
        error: 'Not Found',
        endpoints: ['/loon', '/nodes', '/status', '/health']
      }, 404);
    } catch (error) {
      console.error(error);
      return json({
        ok: false,
        error: error?.message || String(error)
      }, 502);
    }
  }
};
