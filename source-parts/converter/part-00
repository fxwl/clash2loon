const BUILTIN_POLICIES = new Set([
  'DIRECT', 'REJECT', 'REJECT-DROP', 'REJECT-NO-DROP', 'PROXY'
]);

function str(v) { return v == null ? '' : String(v); }
function q(v) {
  const s = str(v).replace(/\\/g, '\\\\').replace(/"/g, '\\"').replace(/[\r\n]+/g, ' ');
  return `"${s}"`;
}
function pv(v) {
  // Follow Loon's documented examples for named parameters: path=/x,
  // host=example.com, sni=example.com, short-id=abcd, alpn=http1.1.
  // Quote only when a delimiter would make the config line ambiguous.
  const s = str(v).replace(/[\r\n]+/g, ' ').trim();
  return /[,"\s]/.test(s) ? q(s) : s;
}
function cleanName(v) { return str(v).replace(/[\r\n]+/g, ' ').trim(); }
function bool(v, fallback = false) { return v == null ? fallback : Boolean(v); }
function uniqueName(preferred, used) {
  let out = preferred;
  let i = 2;
  while (used.has(out)) out = `${preferred} ${i++}`;
  used.add(out);
  return out;
}
function regexEscape(v) {
  return cleanName(v).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}
function fnv1a(text) {
  let h = 0x811c9dc5;
  for (let i = 0; i < text.length; i++) {
    h ^= text.charCodeAt(i);
    h = Math.imul(h, 0x01000193) >>> 0;
  }
  return h.toString(16).padStart(8, '0');
}

function wsOptions(proxy, params) {
  const ws = proxy['ws-opts'] || {};
  if (ws.path) params.push(`path=${pv(ws.path)}`);
  const headers = ws.headers || {};
  const host = headers.Host ?? headers.host;
  if (host) params.push(`host=${pv(Array.isArray(host) ? host[0] : host)}`);
}
function httpOptions(proxy, params) {
  const h = proxy['http-opts'] || {};
  if (Array.isArray(h.path) && h.path.length) params.push(`path=${pv(h.path[0])}`);
  else if (h.path) params.push(`path=${pv(h.path)}`);
  const headers = h.headers || {};
  const host = headers.Host ?? headers.host;
  if (host) params.push(`host=${pv(Array.isArray(host) ? host[0] : host)}`);
}

// Conservative on purpose: tls-profile requires newer Loon builds and Mihomo's
// client-fingerprint vocabulary is not one-to-one with Loon. The official
// Reality example does not require tls-profile, so v1.4 omits it by default.
function tlsCommon(proxy, params, tlsEnabled = true) {
  if (!tlsEnabled) return;
  const sni = proxy.servername ?? proxy.sni;
  if (sni) params.push(`sni=${pv(sni)}`);
  if (proxy['skip-cert-verify'] != null) {
    params.push(`skip-cert-verify=${bool(proxy['skip-cert-verify'])}`);
  }
}
const LOON_TLS_PROFILES = new Set(['global', 'default', 'safari-ios18', 'safari-ios-26', 'chrome', 'chrome147']);
function addTlsProfile(proxy, params) {
  const fp = cleanName(proxy?.['client-fingerprint']).toLowerCase();
  if (LOON_TLS_PROFILES.has(fp)) params.push(`tls-profile=${fp}`);
}
function addAlpn(proxy, params) {
  const values = Array.isArray(proxy?.alpn)
    ? proxy.alpn.map(cleanName).filter(Boolean)
    : (proxy?.alpn ? [cleanName(proxy.alpn)] : []);
  if (values.length) params.push(`alpn=${pv(values.join(','))}`);
}
function addCommonNodeOptions(proxy, params) {
  const fastOpen = proxy?.tfo ?? proxy?.['fast-open'];
  if (fastOpen != null) params.push(`fast-open=${bool(fastOpen)}`);
  if (proxy?.['block-quic'] != null) params.push(`block-quic=${bool(proxy['block-quic'])}`);

  const ipMode = {
    dual: 'dual',
    ipv4: 'v4-only',
    ipv6: 'v6-only',
    'ipv4-prefer': 'prefer-v4',
    'ipv6-prefer': 'prefer-v6'
  }[cleanName(proxy?.['ip-version']).toLowerCase()];
  if (ipMode) params.push(`ip-mode=${ipMode}`);

  const serverDns = proxy?.['server-dns'];
  if (Array.isArray(serverDns) && serverDns.length) {
    params.push(`server-dns=${q(serverDns.map(cleanName).filter(Boolean).join(','))}`);
  } else if (serverDns) {
    params.push(`server-dns=${q(cleanName(serverDns))}`);
  }
}
function normalizedTransport(proxy, supported, warnings, code) {
  const transport = cleanName(proxy?.network || 'tcp').toLowerCase() || 'tcp';
  if (supported.has(transport)) return transport;
  warnings.push({
    code,
    node: cleanName(proxy?.name),
    detail: `Mihomo transport ${transport} is not documented by Loon for this protocol; node was omitted.`
  });
  return null;
}
function appendReality(proxy, params) {
  const reality = proxy?.['reality-opts'];
  if (!reality) return false;
  if (reality['public-key']) params.push(`public-key=${q(reality['public-key'])}`);
  if (reality['short-id'] != null) params.push(`short-id=${pv(reality['short-id'])}`);
  return true;
}
function bandwidthMbps(value) {
  const match = str(value).trim().match(/^(\d+(?:\.\d+)?)\s*(?:m|mbps)?$/i);
  if (!match) return null;
  const n = Number(match[1]);
  return Number.isFinite(n) && n > 0 ? n : null;
}

function convertVless(proxy, warnings) {
  const name = cleanName(proxy.name);
  const transport = normalizedTransport(proxy, new Set(['tcp', 'ws', 'http']), warnings, 'VLESS_TRANSPORT_UNSUPPORTED');
  if (!transport) return null;
  const params = [`transport=${transport}`];
  if (transport === 'ws') wsOptions(proxy, params);
  else if (transport === 'http') httpOptions(proxy, params);

  const reality = proxy['reality-opts'];
  const tlsEnabled = bool(proxy.tls) || Boolean(reality);
  if (proxy.flow) params.push(`flow=${proxy.flow}`);
  appendReality(proxy, params);
  if (reality?.['_spider-x']) {
    warnings.push({
      code: 'VLESS_REALITY_SPIDER_X_DROPPED', node: name,
      detail: 'Mihomo reality-opts._spider-x has no documented Loon equivalent and was omitted.'
    });
  }
  params.push(`over-tls=${tlsEnabled}`);
  tlsCommon(proxy, params, tlsEnabled);
  addTlsProfile(proxy, params);
  addAlpn(proxy, params);
  addCommonNodeOptions(proxy, params);
  params.push(`udp=${bool(proxy.udp, true)}`);
  return `${name} = VLESS,${proxy.server},${proxy.port},${q(proxy.uuid)},${params.join(',')}`;
}

function convertVmess(proxy, warnings) {
  const name = cleanName(proxy.name);
  const transport = normalizedTransport(proxy, new Set(['tcp', 'ws', 'http']), warnings, 'VMESS_TRANSPORT_UNSUPPORTED');
  if (!transport) return null;

  const cipherMap = {
    auto: 'auto',
    none: 'none',
    zero: 'none',
    'aes-128-gcm': 'aes-128-gcm',
    'aes-128-cfb': 'aes-128-cfb',
    'chacha20-poly1305': 'chacha20-ietf-poly1305',
    'chacha20-ietf-poly1305': 'chacha20-ietf-poly1305'
  };
  const sourceCipher = cleanName(proxy.cipher || 'auto').toLowerCase();
  const cipher = cipherMap[sourceCipher];
  if (!cipher) {
    warnings.push({
      code: 'VMESS_CIPHER_UNSUPPORTED',
      node: name,
      detail: `Mihomo VMess cipher ${sourceCipher} is not documented by Loon; node was omitted.`
    });
    return null;
  }

  const params = [`transport=${transport}`, `alterId=${Number(proxy.alterId ?? proxy['alter-id'] ?? 0) || 0}`];
  if (transport === 'ws') wsOptions(proxy, params);
  else if (transport === 'http') httpOptions(proxy, params);

  const reality = appendReality(proxy, params);
  const tlsEnabled = bool(proxy.tls) || reality;
  params.push(`over-tls=${tlsEnabled}`);
  tlsCommon(proxy, params, tlsEnabled);
  addTlsProfile(proxy, params);
  addAlpn(proxy, params);
  addCommonNodeOptions(proxy, params);
  params.push(`udp=${bool(proxy.udp, true)}`);

  return `${name} = VMess,${proxy.server},${proxy.port},${cipher},${q(proxy.uuid)},${params.join(',')}`;
}
function convertTrojan(proxy, warnings) {
  const name = cleanName(proxy.name);
  const transport = normalizedTransport(proxy, new Set(['tcp', 'ws', 'http']), warnings, 'TROJAN_TRANSPORT_UNSUPPORTED');
  if (!transport) return null;
  const params = [];
  if (transport !== 'tcp') params.push(`transport=${transport}`);
  if (transport === 'ws') wsOptions(proxy, params);
  else if (transport === 'http') httpOptions(proxy, params);
  appendReality(proxy, params);
  tlsCommon(proxy, params, true);
  addTlsProfile(proxy, params);
  addAlpn(proxy, params);
  addCommonNodeOptions(proxy, params);
  params.push(`udp=${bool(proxy.udp, true)}`);
  return `${name} = trojan,${proxy.server},${proxy.port},${q(proxy.password)},${params.join(',')}`;
}
function normalizeSha256(v) {
  if (!v) return null;
  const raw = str(v).replace(/^sha256[:=]/i, '').trim();
  return raw || null;
}
function convertHysteria2(proxy, warnings) {
  const name = cleanName(proxy.name);
  const params = [];
  if (proxy.sni) params.push(`sni=${pv(proxy.sni)}`);
  if (proxy['skip-cert-verify'] != null) params.push(`skip-cert-verify=${bool(proxy['skip-cert-verify'])}`);

  const fp = normalizeSha256(proxy.fingerprint);
  if (fp) params.push(`tls-cert-sha256=${pv(fp)}`);
  addAlpn(proxy, params);

  if (proxy.obfs && proxy.obfs !== 'salamander') {
    warnings.push({
      code: 'HY2_OBFS_UNSUPPORTED',
      node: name,
      detail: `Mihomo Hysteria2 obfs ${proxy.obfs} is not documented by Loon; obfs parameters were omitted.`
    });
  } else if (proxy['obfs-password']) {
    params.push(`salamander-password=${q(proxy['obfs-password'])}`);
  }

  if (proxy.ports) {
    const serverPorts = str(proxy.ports).replace(/(\d+)-(\d+)/g, '$1:$2');
    params.push(`server-ports=${q(serverPorts)}`);
    if (proxy['hop-interval'] != null) {
      const hop = Number(proxy['hop-interval']);
      if (Number.isFinite(hop) && hop > 0) params.push(`hop-interval=${hop}`);
      else warnings.push({
        code: 'HY2_HOP_INTERVAL_UNSUPPORTED',
        node: name,
        detail: `Mihomo hop-interval=${proxy['hop-interval']} cannot be represented by Loon's numeric hop-interval; Loon default will be used.`
      });
    }
  }

  const down = bandwidthMbps(proxy.down);
  if (down != null) params.push(`download-bandwidth=${down}`);
  else if (proxy.down != null) warnings.push({
    code: 'HY2_DOWNLOAD_BANDWIDTH_UNSUPPORTED',
    node: name,
    detail: `Mihomo down=${proxy.down} could not be normalized to Mbps and was omitted.`
  });

  addCommonNodeOptions(proxy, params);
  params.push(`udp=${bool(proxy.udp, true)}`);
  return `${name} = Hysteria2,${proxy.server},${proxy.port},${q(proxy.password)},${params.join(',')}`;
}

