function wsOptions(proxy, params) {
  const ws = proxy['ws-opts'] || {};
  if (ws.path) params.push(`path=${pv(ws.path)}`);
  const headers = ws.headers || {};
  const host = headers.Host ?? headers.host;
  if (host) params.push(`host=${pv(Array.isArray(host) ? host[0] : host)}`);
}
function httpOptions(proxy, params) {
